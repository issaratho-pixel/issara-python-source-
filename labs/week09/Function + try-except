def deposit(money):
    
    try:
        amount = float(input("กรอกจำนวนเงินที่ต้องการฝาก: "))
        
        if amount <= 0:
            raise ValueError("จำนวนเงินฝากต้องมากกว่า 0")
        
        new_balance = money + amount
    
    except ValueError as e:
        print(f"เกิดข้อผิดพลาด: {e}")
    
    else:
        print("ฝากเงินสำเร็จ")
        print(f"ยอดเงินคงเหลือ: {new_balance:.2f} บาท")
    
    finally:
        print("สิ้นสุดรายการฝากเงิน")

balance = 1000
print(f"ยอดเงินเริ่มต้น: {balance} บาท")
deposit(balance)